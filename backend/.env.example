# ==========================================
# Multi-Tenant Agency CRM - Environment Config
# ==========================================
# Copy this file to .env before starting the services:
# cp .env.example .env

# --- FastAPI Application ---
PROJECT_NAME="Multi-Tenant Agency CRM Backend"
PORT=8000

# --- Meta (Facebook) Lead Ads Webhook Configuration ---
# 15-digit Meta App ID from Meta App Dashboard
META_APP_ID="YOUR_META_APP_ID"

# Meta App Secret used for HMAC SHA-256 X-Hub-Signature-256 verification
META_APP_SECRET="YOUR_META_APP_SECRET"

# Custom secret token created by you and configured in Meta Webhook settings (GET verification challenge)
META_VERIFY_TOKEN="YOUR_META_VERIFY_TOKEN"

# Master System User Access Token tied to Business Manager (Graph API lead fetching)
MASTER_SYSTEM_USER_ACCESS_TOKEN="YOUR_MASTER_SYSTEM_USER_ACCESS_TOKEN"

# Meta Graph API version
META_GRAPH_API_VERSION="v20.0"

# --- Database Configuration (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# When using Docker Compose locally: postgresql://postgres:postgrespassword@127.0.0.1:5432/agency_crm
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5432/agency_crm"

# --- Cache & Task Queue Configuration (Redis & Celery) ---
# Format: redis://<host>:<port>/<db>
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"

# --- JWT Authentication & Security ---
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY"
JWT_ALGORITHM="HS256"
